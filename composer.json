{
    "name": "apixx/think-filesystem",
    "description": "Flysystem storage manager for ThinkPHP, supports local / aliyun / qcloud / huawei / qiniu disks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "flysystem",
        "filesystem",
        "storage",
        "oss"
    ],
    "authors": [
        {
            "name": "pillar",
            "email": "ltmn@qq.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^6.1 || ^8.0",
        "guzzlehttp/guzzle": "^7.0",
        "apixx/flysystem-oss": "^1.0",
        "apixx/flysystem-cos": "^1.0",
        "apixx/flysystem-obs": "^1.0",
        "apixx/flysystem-qiniu": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "apixx\\filesystem\\": "src"
        }
    },
    "extra": {
        "think": {
            "services": [
                "apixx\\filesystem\\Service"
            ]
        }
    }
}
